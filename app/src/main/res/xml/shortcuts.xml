<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket #108 (T3): native launcher shortcuts. Each intent action is
     routed by MainActivity → AgentViewModel.handleIncomingIntent → AgentNav.
     Nothing executes without the user — Voice Command opens the sheet,
     New Session starts a fresh Session thread, Schedules opens the list. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice_command"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_voice_short">
        <intent
            android:action="com.aurviz.agent.action.VOICE_COMMAND"
            android:targetPackage="com.aurviz.agent"
            android:targetClass="com.aurviz.agent.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_session"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_new_session_short">
        <intent
            android:action="com.aurviz.agent.action.NEW_SESSION"
            android:targetPackage="com.aurviz.agent"
            android:targetClass="com.aurviz.agent.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="schedules"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_schedules_short">
        <intent
            android:action="com.aurviz.agent.action.SCHEDULES"
            android:targetPackage="com.aurviz.agent"
            android:targetClass="com.aurviz.agent.MainActivity" />
    </shortcut>
</shortcuts>
